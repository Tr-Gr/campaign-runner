{
 "datasets": [
  {
   "name": "ds_kpi",
   "displayName": "KPIs",
   "queryLines": [
    "SELECT\n",
    "  (SELECT COUNT(*) FROM camp_calendar WHERE send_date BETWEEN date_trunc('week', current_date()) AND date_add(date_trunc('week', current_date()), 6)) AS sends_this_week,\n",
    "  (SELECT COALESCE(SUM(max_pieces), 0) FROM camp_calendar WHERE send_date BETWEEN date_trunc('week', current_date()) AND date_add(date_trunc('week', current_date()), 6)) AS pieces_this_week,\n",
    "  (SELECT COUNT(*) FROM camp_calendar WHERE priority_class = 'regulatory' AND send_date >= current_date() AND send_date < date_add(current_date(), 14)) AS regulatory_next_14d,\n",
    "  (SELECT COUNT(*) FROM camp_run_exceptions WHERE exception_state = 'FAILED') AS failed_sends,\n",
    "  (SELECT COUNT(*) FROM camp_run_exceptions WHERE exception_state IN ('LATE', 'NOT_DELIVERED')) AS late_sends"
   ]
  },
  {
   "name": "ds_week",
   "displayName": "This week's sends",
   "queryLines": [
    "SELECT send_date, send_time_ct, campaign_name, priority_class, channel, owner_team, max_pieces, approved\n",
    "FROM camp_calendar\n",
    "WHERE send_date BETWEEN date_trunc('week', current_date()) AND date_add(date_trunc('week', current_date()), 6)\n",
    "ORDER BY send_date, send_time_ct"
   ]
  },
  {
   "name": "ds_daily",
   "displayName": "Sends by day and priority (next 30 days)",
   "queryLines": [
    "SELECT send_date, priority_class, SUM(max_pieces) AS pieces\n",
    "FROM camp_calendar WHERE send_date >= current_date() AND send_date < date_add(current_date(), 30)\n",
    "GROUP BY send_date, priority_class ORDER BY send_date"
   ]
  },
  {
   "name": "ds_channel",
   "displayName": "Volume by channel (next 30 days)",
   "queryLines": [
    "SELECT channel, SUM(max_pieces) AS pieces, COUNT(*) AS sends\n",
    "FROM camp_calendar WHERE send_date >= current_date() AND send_date < date_add(current_date(), 30)\n",
    "GROUP BY channel ORDER BY pieces DESC"
   ]
  },
  {
   "name": "ds_type",
   "displayName": "Delivery status by campaign (last 14 days)",
   "queryLines": [
    "SELECT campaign_name, egress_status, SUM(pieces) AS pieces\n",
    "FROM camp_message_summary WHERE run_date >= date_sub(current_date(), 14)\n",
    "GROUP BY campaign_name, egress_status ORDER BY pieces DESC"
   ]
  },
  {
   "name": "ds_run",
   "displayName": "Run status by day",
   "queryLines": [
    "SELECT run_date, campaign_status, COUNT(*) AS campaigns, SUM(messages_final) AS pieces\n",
    "FROM camp_run_history GROUP BY run_date, campaign_status ORDER BY run_date, campaign_status"
   ]
  },
  {
   "name": "ds_exceptions",
   "displayName": "Failed, late, or pending sends",
   "queryLines": [
    "SELECT send_date, send_time_ct, campaign_name, priority_class, exception_state, pending_pieces, error_message\n",
    "FROM camp_run_exceptions\n",
    "WHERE exception_state IN ('FAILED', 'NOT_DELIVERED', 'LATE', 'AWAITING_APPROVAL', 'PENDING')\n",
    "ORDER BY CASE exception_state WHEN 'FAILED' THEN 1 WHEN 'NOT_DELIVERED' THEN 2 WHEN 'LATE' THEN 3 ELSE 4 END, send_date, send_time_ct"
   ]
  }
 ],
